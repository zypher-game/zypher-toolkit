.banner
  padding-top: 30px
  padding-bottom: 40px
  display: flex
  justify-content: space-between
  align-items: flex-start
  @media screen and (max-width: 1200px)
    flex-direction: column-reverse;
  @media screen and (max-width: 830px)
    padding-top: 20px
    padding-bottom: 30px
  :global(.pixel_active_tab)
    margin: 0 0 20px 0
  :global(.active_tvl_tab)
    margin-top: 20px
    margin-bottom: 20px
    @media screen and (max-width: 830px)
      margin-top: 0
      margin-bottom: 0
.fl_title
  font-weight: 600
  font-size: 16px
  padding-bottom: 10px
  @media screen and (max-width: 830px)
    padding-bottom: 8px
.fl_text
  width: 355px
  height: 32px
  background-image: url($preStaticUrl + '/img/tvl/topic_01.png')
  background-repeat: no-repeat
  background-size: cover;
  background-position: center;
  h3
    font-size: 12px
    color: #934417
    font-weight: 600
    padding-left: 35px
    line-height: 32px
.fl_grey
  font-size: 14px
  color: #959BA8
  padding-bottom: 20px
  &:last-child
    padding-bottom: 0

.label
  margin-top: 8px
  margin-bottom: 8px
  display: flex
  justify-content: flex-start
  align-items: center
  gap: 6px
  svg
    size: 18px
    rect
      fill: #FFD02B
  p
    font-size: 14px
    color: #FFD02B