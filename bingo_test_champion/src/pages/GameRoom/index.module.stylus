.gameRoomCard
  max-width: 1200px
  margin: 0 auto
  padding: 10px
  position: relative
  @media screen and (max-width: 830px)
    max-width: 80vw
    margin: 60px auto 0
    padding: 0
    min-width: 370px;

.matchLinesWrapper 
  border-color: #ffd690;
  border-width: 3px;
  border-style: solid;
  color: #fff5e1;
  text-shadow: -1px -1.5px 0px #381f05;
  text-align: center;
  border-radius: 40px;
  background: #613c17;
  box-shadow: 0px 2px 0px 0px rgba(0, 0, 0, 0.25) inset, 0px 1px 0px 0px #f5cb89 inset, 0px -2px 0px 0px #f9daa6 inset;
  font-size: 34px
  width: 147px
  height: 70px
  line-height: 62px
  font-family: Lemon
  @media screen and (max-width: 830px)
    font-size: 24px
    width: 128px
    height: 54px
    line-height: 48px



.gameRoom
  position:relative
  .board
    border: 0px solid var(--var-btn-border)
  .playersAvatarInfo 
    padding-left: 10px
  .players
    flex: 1
    display: flex
    flex-direction: column
    justify-content: flex-start
    gap: 10px
    margin: 20px 20px;
    color: #fff
  .choosing
    color: #dc0097
    font-size: 20px
    line-height: 1.5
  .playerNum
    
    color: #804700
    font-size: 16px
    line-height: 1.5
 
  .gameAction
    display: flex
    align-items: center
    justify-content: space-between
    margin-top: 24px
    gap: 14px
  .lineCompleted
    color: #FFF5E1
    font-size: 34px
    text-shadow: -1px -1.5px 0px #381F05;
    padding:10px 25px
    
    text-align: center
    border: 5px solid #FFD690
    border-radius: 40px
    background:#613C17
  .bingoButton
    flex: 1
    border: none
    background: linear-gradient(180deg, #88E413 0%, #2A9507 100%)
    color: #FFF5E1
    font-size: 28px
    
    padding: 10px 25px
    border-radius: 40px
    border: 5px solid #FFD690
    height: auto
    box-shadow: 0px 1px 2px #6D6D6D;
    &:disabled
      color:#E2E2E2
      background: linear-gradient(180deg, #FFFFFF 0%, #A0A5A5 39.58%, #696969 100%);
      pointer-events: none
  
  .player
    background: #8E571E
    border-radius:21px
    display:flex
    left: 13px
    position:absolute
    align-items:center
    .ant-progress-outer
      height: 17px
  .winerModalText
    padding:20px 0
    font-size:20px
    color: #864802
    
  .BoxCard 
    background: #613C17;
    box-shadow: inset 0px -1px 0px #BF905B;
    border-radius: 24.0229px;
    padding: 12px 20px
.gameHome
  .loadTitle
    max-width: 673px
    width: 60%;
    position: absolute;
    top: 30%
    left: 50%
    transform: translate(-50%, -50%)
    @media screen and (max-width: 830px)
      width: 80%;
  .progressBox
    max-width: 1082px
    width: 60%;
    position: absolute;
    top: 75%
    left: 50%
    transform: translate(-50%, -50%)
    @media screen and (max-width: 830px)
      width: 90%;
      top: 60%
  .progress
    width: 100%;
    height: 62px;
    padding: 0 39px 0 37px;
    display:flex;
    align-items: center;
    justify-content: center;
    background: url($preStaticUrl + '/img/bingo/loading-box.png') no-repeat center;
    background-size: 100% 100%;
    font-family: "Lemon";
    @media screen and (max-width: 830px)
      height: 24px;
      padding: 1px 3.3%;
      :global(.ant-progress)
        height: 14px;
        line-height: 14px;
      :global(.ant-progress-inner)
        border-radius: 10.019px;
        background: #8E571E;
        box-shadow: 0px 1.4313037395477295px 3.816809892654419px 0px rgba(0, 0, 0, 0.25) inset;
        vertical-align: baseline;
    
  .progressTip
    text-align: center;
    color: #8E571E;
    padding-top: 20px;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    @media screen and (max-width: 830px)
      font-size: 12px;
      
@keyframes borderColor
  from
    border-color: rgba(88, 211, 30, 1)

  to
    border-color: rgba(88, 211, 30, 1)
.exit
  padding: 5px 18px
  background: #6673FF
  display:flex
  gap: 5px
  align-items: center
  justify-content: center
  border-radius:24px
  
  color: #FFF;
  font-size: 16px;
.countdown
  padding: 5px 12px
  background: rgba(0, 0, 0, 0.6)
  display:flex
  gap: 10px
  align-items: center
  justify-content: center
  border-radius:24px
  
  color: #FFF;
  margin-left: 20px
  font-size: 16px;
  .countdownLabel
    opacity: 0.69;

  



  
// ... existing code ...

.roundTip
  position: absolute
  width: 100%
  top: 2px
  left: 0
  div
    text-align: center
    font-size: 14px
    color: #804700
    margin: 0 auto
    font-weight: 600
    line-height: 27px
    span
      color: #367e00
  &.mobile
    div
      font-size: 12px
      width: 320px
      line-height: 14px
      padding: 11px 0 8px

.gameCheckerBoard
  border-radius: 72px
  padding-top: 20px
  background: radial-gradient(60.29% 8.91% at 49.84% -4.99%, #f8a844 0%, #ca7c16 100%)
  &.mobile
    border-radius: 50px
    padding-top: 10px
    width: 340px
    margin: 0 auto

.gamePadding
  position: relative
  border-radius: 60px
  background: #eabf6e
  padding: 30px 21px 27px
  box-shadow: 0px -0.1px 1px 0px #d09528 inset
  &.mobile
    border-radius: 42px
    padding: 40px 10px 15px
    width: 330px

.gameBackground
  border-radius: 40px
  background: #99622a
  padding: 20px 15px
  height: 540px
  display: flex-start
  align-items: center
  justify-content: center
  flex-wrap: wrap
  box-shadow: 0px 7px 0px 0px rgba(0, 0, 0, 0.25) inset, 0px 1px 0px 0px #f5cb89 inset, 0px -7px 0px 0px #ffe0a6 inset
  @media (max-width: 830px)
    padding: 15px 12px
    height: auto

.title
  color: #fff0cf
  text-shadow: -1.5px -1px 0px #3b2d1a
  font-weight: 600
  font-size: 20px

.rulesCard
  border-radius: 24.023px
  background: #613c17
  margin-top: 10px
  box-shadow: 0px -1px 0px 0px #bf905b inset
  font-size: 16px
  line-height: 30px
  padding: 10px 18px
  .rulesLabel
    color: rgba(255, 240, 207, 0.6)
  .rulesValue
    color: #fff0cf
  .rulesAmountValue
    color: #db5f16
    font-size: 24px
    padding-bottom: 23px

.bingoControllerButtonWrapper
  display: flex
  align-items: center
  justify-content: space-between
  padding-top: 20px
  gap: 10px
  &.mobile
    padding-top: 10px

.playerTurn
  position: absolute
  top: 50%
  transform: translateY(-50%) translateX(-50%)
  left: 50%
  text-align: center
  color: #62380c
  font-weight: 400
  font-family: Lemon
  font-size: 20px
  width: 100%
  height: 100%
  max-width: 633px
  max-height: 133px
  padding: 20px
  z-index: 1
  background: url($preStaticUrl + '/img/bingo/player-turn_en_US.webp') no-repeat center
  background-size: 100% auto
  @media (max-width: 830px)
    padding: 40px
    font-size: 14px