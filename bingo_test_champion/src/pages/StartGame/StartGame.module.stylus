.startGameWrapper
  border-radius: 32px
  background:url($preStaticUrl + '/img/bingo/pannel.webp')  no-repeat;
  width: 1165px
  background-size: 100% 100%;
  box-shadow: 0px -2px 2px 0px rgba(0, 0, 0, 0.25) inset, 0px 2px 1px 0px rgba(255, 255, 255, 0.3) inset,
    0px 0px 4px 2px rgba(255, 255, 255, 0.2) inset;
  height: 717px
  margin: 0px auto;
  position: relative;
  padding-bottom: 10px;
  @media screen and (max-width: 830px)
    border-radius: 12px
    width: 355px
    height: 621px
    background-image: url($preStaticUrl + '/img/bingo/pannel_m_en_US.webp')
    &.tg
      background-image: url($preStaticUrl + '/img/bingo/pannel_m_tg.webp')
.startGameHead
  lemonFont()
  padding-left: 40px;
  padding-right: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  height: 141px
  font-size: 25px
  @media screen and (max-width: 830px)
    height:116px
    font-size:12px
  .title 
    padding-bottom: 10px;
    font-family: Lemon;
    font-size: 25px
    font-weight: 600;
    display: flex
    justify-content: center
    align-items: center
    @media screen and (max-width: 830px)
      font-size: 18px
  .subtitle 
    font-size: 12px;
    font-family: Lemon;
    img 
      padding-right: 8px;
.startGame
  display: flex
  align-items: center
  justify-content: center
  height: 100%
  padding-bottom: 70px
  &.startTgGame
    .wrap
      @media screen and (max-width: 830px)
        margin-top: 50px
    .startGameWrapper
      @media screen and (max-width: 830px)
        width: 320px
        height: 600px

.wrap 
  padding: 10px
  @media screen and (max-width: 830px)
    padding: 4vh 10px 10px
.close
  position: absolute;
  top: 25px
  right: 25px
  width:  ''
  @media screen and (max-width: 830px)
    top: 15px
    right: 15px
    width: 24px
.cardsWrap
  height: 423px
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 29px
  padding-right: 29px
  @media screen and (max-width: 830px)
    height: 438px
    padding-left: 15px
    padding-right: 15px

.content
  height: 503px
  background-repeat: no-repeat;
  background-size: 100% 100%;
  @media screen and (max-width: 830px)
    height: 503px
.stepsWrapper
  margin-left: 79px
  margin-right: 79px
  height: 102px
  @media screen and (max-width: 830px)
    margin-left: 19px
    margin-right: 19px
    height: 46px
.startGameHead .titleChampion
  font-size: 32px
.titleSmall
  display: flex
  justify-content: center
  align-items: center
  background-image: url($preStaticUrl + "/img/bingo/btn_bg.webp");
  background-repeat: no-repeat;
  background-size: 100% 100%;
  background-position: center;
  font-size: 20px
  font-family: "Poppins"
  font-weight: 600
  color: #FFF0CF
  padding: 2px 30px 0
  margin-left: 20px
  height: 40px
.spanTime
  display: inline-block
  text-align: center 
.spanLast
  width: 30px          
  text-align: right 
.spanPoint
  display: inline-block
  width: 8px         
  text-align: center