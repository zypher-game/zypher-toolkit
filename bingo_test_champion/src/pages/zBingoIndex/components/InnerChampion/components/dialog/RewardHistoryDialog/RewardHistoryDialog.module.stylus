body [data-reach-dialog-content].championRule
  width 700px
  background: url($preStaticUrl + '/img/bingo/dialog_bg.webp') no-repeat
  position relative
  padding: 60px 80px 100px
  background-size: 100% 100%
  @media screen and (max-width: 830px)
    width: 100%
    padding: 47px 50px 80px 50px
    max-height 500px
    overflow: hidden
  .inner
    @media screen and (max-width: 830px)
      height: 367px
      overflow-y: scroll
      &::-webkit-scrollbar 
        display: none;

      &::-webkit-scrollbar-thumb 
        background-color: rgba(143, 72, 0, 0.5); 
        border-radius: 8px; 
  .close
    position absolute
    top 40px
    right 40px
    @media screen and (max-width: 830px)
      width 34px
      height 34px
      right 20px
  